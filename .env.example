DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_GUILD_ID=your_server_id_here
BOT_API_PORT=8080
BOT_API_SECRET=replace_with_a_long_random_secret
# Optional: management app URL for completed voice-session delivery.
ACTIVITY_API_URL=https://manage.drowsyvocals.com
# Optional: defaults to BOT_API_SECRET when omitted.
ACTIVITY_API_SECRET=
# Optional: set to true only if Server Presences intent is enabled in Discord Developer Portal.
ENABLE_PRESENCE_INTENT=false
# Comma-separated Discord user IDs that may post Discord invite links.
LINK_ALLOWED_USER_IDS=
